# VodiWalker روی Shiprr — App → Settings → Environment variables
# مقادیر خالی و دامنه را قبل از Deploy با مقادیر واقعی جایگزین کنید.
# این فایل نمونه است؛ خودِ برنامه آن را به‌صورت خودکار نمی‌خواند.

ADMIN_USERNAME=VodiAdmin
ADMIN_PASSWORD=
# یک رشته تصادفی جداگانه تولید کنید و بین Deployها نگه دارید.
SECRET_KEY=
PUBLIC_BASE_URL=https://your-app.shiprr.dev

# برای ماندگاری داده‌ها روی Shiprr یک دیتابیس PostgreSQL اختصاصی لازم است.
# نمونه: postgresql://user:password@db.example.com/vodiwalker?sslmode=verify-full
DATABASE_URL=

# Shiprr ترافیک وب را به PORT می‌رساند؛ شنونده‌های TCP خام را فعال نکنید.
VW_HTTP_ONLY=1
KEEPALIVE_ENABLED=0

# اختیاری — برای راه‌اندازی اولیه ربات تلگرام
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_IDS=

# PORT را Shiprr تعیین می‌کند؛ به‌صورت دستی override نکنید.
